{
  "info": {
    "_postman_id": "c5a6ad0b-5a45-4d1c-8f5f-3b0310a7b2f8",
    "name": "Digital Wallet - E2E Flow",
    "description": "Ready-to-import collection for quick end-to-end testing of the Digital Wallet project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": "testuser@example.com"
    },
    {
      "key": "userPhone",
      "value": "9876543210"
    },
    {
      "key": "userPassword",
      "value": "Password1"
    },
    {
      "key": "otp",
      "value": "123456"
    },
    {
      "key": "receiverEmail",
      "value": "seconduser@example.com"
    },
    {
      "key": "addAmount",
      "value": "5000"
    },
    {
      "key": "transferAmount",
      "value": "500"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "2. Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{userEmail}}\",\n  \"phone\": \"{{userPhone}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "3. Verify OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let data = {};",
              "try { data = pm.response.json(); } catch (e) {}",
              "if (data && data.data && data.data.accessToken) {",
              "  pm.collectionVariables.set('token', data.data.accessToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"otp\": \"{{otp}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/verify-otp",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "verify-otp"
          ]
        }
      }
    },
    {
      "name": "4. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let data = {};",
              "try { data = pm.response.json(); } catch (e) {}",
              "if (data && data.data && data.data.accessToken) {",
              "  pm.collectionVariables.set('token', data.data.accessToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "5. Wallet Balance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/wallet/balance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "wallet",
            "balance"
          ]
        }
      }
    },
    {
      "name": "6. Payment Methods",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/payment/methods",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payment",
            "methods"
          ]
        }
      }
    },
    {
      "name": "7. Add Money (Mock)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": {{addAmount}},\n  \"paymentGateway\": \"MOCK\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payment/create-order",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payment",
            "create-order"
          ]
        }
      }
    },
    {
      "name": "8. Transfer Money",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"receiverEmail\": \"{{receiverEmail}}\",\n  \"amount\": {{transferAmount}},\n  \"description\": \"test transfer\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/wallet/transfer",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "wallet",
            "transfer"
          ]
        }
      }
    },
    {
      "name": "9. Wallet Transactions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/wallet/transactions?page=1&limit=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "wallet",
            "transactions"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "10. Wallet Stats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/wallet/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "wallet",
            "stats"
          ]
        }
      }
    },
    {
      "name": "11. Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        }
      }
    }
  ]
}
